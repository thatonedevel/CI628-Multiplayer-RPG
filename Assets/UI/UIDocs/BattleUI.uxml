<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/USS/BattleUSS.uss?fileID=7433441132597879392&amp;guid=d5735aee37e463e47b2d123520d232cf&amp;type=3#BattleUSS" />
    <ui:VisualElement name="UIRoot" style="flex-grow: 1; opacity: 1; visibility: visible; overflow: visible; position: absolute; top: 36px; left: -1px; height: 1039px; width: 1920px;">
        <ui:VisualElement name="TargetPanel" enabled="true" class="panel" style="flex-grow: 1; left: 1253px; background-size: 100px 100%; width: 347px; height: 99px; max-height: 288px; max-width: 340px; position: absolute; top: 876px; transform-origin: right bottom; scale: 3 3; visibility: hidden;">
            <ui:VisualElement name="TargetSelectionVBox" style="flex-grow: 1; width: 334px; margin-top: 5px; align-items: stretch; justify-content: space-evenly; align-self: flex-end; visibility: hidden;">
                <ui:Button text="Button" name="Selection0" focusable="false" class="battleSelectorButton targetButton" style="height: 0;">
                    <Bindings>
                        <ui:DataBinding property="text" data-source-path="firstTargetName" data-source="project://database/Assets/SOInstances/ProperBattleTargets.asset?fileID=11400000&amp;guid=23a53709ea6ae7d408e34fa95849fc37&amp;type=2#ProperBattleTargets" binding-mode="ToTarget" />
                    </Bindings>
                </ui:Button>
                <ui:Button text="Button" name="Selection1" enable-rich-text="false" class="battleSelectorButton targetButton">
                    <Bindings>
                        <ui:DataBinding property="text" data-source-path="secondTargetName" data-source="project://database/Assets/SOInstances/ProperBattleTargets.asset?fileID=11400000&amp;guid=23a53709ea6ae7d408e34fa95849fc37&amp;type=2#ProperBattleTargets" binding-mode="ToTarget" />
                    </Bindings>
                </ui:Button>
                <ui:Button text="Button" name="Selection2" class="battleSelectorButton targetButton">
                    <Bindings>
                        <ui:DataBinding property="text" data-source-path="thirdTargetName" data-source="project://database/Assets/SOInstances/ProperBattleTargets.asset?fileID=11400000&amp;guid=23a53709ea6ae7d408e34fa95849fc37&amp;type=2#ProperBattleTargets" binding-mode="ToTarget" />
                    </Bindings>
                </ui:Button>
                <ui:Button text="Button" name="Selection4" double-click-selects-word="false" triple-click-selects-line="false" class="battleSelectorButton targetButton">
                    <Bindings>
                        <ui:DataBinding property="text" data-source-path="fourthTargetName" data-source="project://database/Assets/SOInstances/ProperBattleTargets.asset?fileID=11400000&amp;guid=23a53709ea6ae7d408e34fa95849fc37&amp;type=2#ProperBattleTargets" binding-mode="ToTarget" />
                    </Bindings>
