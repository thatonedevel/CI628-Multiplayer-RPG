            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="MainButtonPanel" class="panel" style="flex-grow: 1; transform-origin: right bottom; min-width: 0; min-height: 0; max-width: 125px; max-height: 125px; right: 22px; bottom: 33px; left: 1773px; align-self: auto; position: absolute; height: 211px; justify-content: center; scale: 3 3;">
            <ui:Button text="Fight" name="FightButton" enabled="false" class="sectionButton" />
            <ui:Button text="Skills" name="SkillButton" enabled="false" class="sectionButton" />
            <ui:Button text="Items" name="ItemButton" enabled="false" class="sectionButton" />
            <ui:Button text="Flee" name="FleeButton" enabled="false" class="sectionButton" />
        </ui:VisualElement>
        <ui:VisualElement name="ScrollButtonHbox" style="flex-grow: 1; position: absolute; height: 36px; width: 92px; top: 933px; left: 1417px; flex-direction: row; background-color: rgb(124, 124, 124); border-top-left-radius: 6px; border-top-right-radius: 6px; border-bottom-right-radius: 6px; border-bottom-left-radius: 6px; visibility: hidden;">
            <ui:Button text="^" name="ScrollUpButton" class="scrollButton" style="font-size: 24px;" />
            <ui:Button text="V" name="ScrollDownButton" class="scrollButton" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
